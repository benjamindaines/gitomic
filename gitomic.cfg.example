# gitomic configuration. Copy to ${XDG_CONFIG_HOME:-~/.config}/gitomic/gitomic.cfg and edit.
# Every key is optional; the value shown is the compiled-in default. Blank lines and '#' comments
# are ignored, as is inline text after a '#'.

# Quiescence window in milliseconds. A burst of file-system events is coalesced into one atomic
# commit once no further event has arrived for this long.
debounce_ms = 1000

# Append " [i/N]" to each commit message at finish, so otherwise identical batch messages stay
# distinguishable in the log. Overridable per run with --numbering / --no-numbering.
finalize_numbering = false

# Staging breadth for an atomic capture: observed | tracked | all.
#   observed (default) stages only the paths the watcher saw change this cycle, intersected with the paths
#                      git reports as changed. New files, file-manager renames, and copies that overwrite a
#                      tracked file are captured; an untracked file the watcher never touched is left alone.
#   tracked            stages modifications to already-tracked files only (git add -u).
#   all                stages every change including untracked files (git add -A).
stage = observed

# Extend the prior atomic commit instead of starting a new one when a capture's staged paths exactly match
# the paths recorded by the session's most recent commit. Turns a burst of debounce cycles that keeps
# returning to the same file(s) into one commit; a different file (or a different set of files) still starts
# a fresh commit. Never applied to `exec`, whose capture always stands on its own.
coalesce_same_file = true

# Reserved for a future always-on multi-repository mode; currently accepted and ignored. The manual,
# cwd-scoped model supersedes it.
# watch_dir = /home/ben/code
