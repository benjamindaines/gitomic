+        let mut job = Job::new(&r.0, &r.head(), &[feat], &[]);
+        assert!(matches!(job.advance().unwrap(), Step::Done));
+        let patch = job.patch(&[]).unwrap();
+        assert_eq!(patch.paths, vec!["b.txt".to_string()]);
